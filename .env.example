# AURA local environment (optional)
# The public site and catalog run without these values.
# Never commit real credentials, API keys, or database passwords.

# Optional: PostgreSQL connection for database-backed features
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aura

# Optional: Ethereum mainnet RPC for live blockchain status/balance checks
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Optional: server port
# PORT=3000
